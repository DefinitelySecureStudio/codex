{
  "spec_version": "1.0.0",
  "id": "prompt.reference.summarize-public-text",
  "version": "1.0.0",
  "name": "Summarize public text",
  "description": "Synthetic reference prompt for a short public-text summary.",
  "purpose": "Produce a concise factual summary of explicitly supplied public text; it does not approve publication or establish Canon.",
  "owners": [
    "@andrewperis"
  ],
  "lifecycle": {
    "status": "draft"
  },
  "tags": [
    "reference",
    "summarization"
  ],
  "inputs": [
    {
      "name": "source_text",
      "description": "Synthetic or already-public text supplied explicitly by the caller.",
      "type": "string",
      "required": true,
      "classification": "public",
      "constraints": {
        "min_length": 1,
        "max_length": 4000
      }
    }
  ],
  "context_slots": [],
  "template": {
    "format": "studio-messages-v1",
    "messages": [
      {
        "role": "instruction",
        "parts": [
          {
            "type": "text",
            "text": "Summarize only the supplied text. State uncertainty and do not invent facts."
          }
        ]
      },
      {
        "role": "user",
        "parts": [
          {
            "type": "text",
            "text": "Source text:\n"
          },
          {
            "type": "input",
            "name": "source_text",
            "format": "text"
          }
        ]
      }
    ]
  },
  "capabilities": {
    "required": [
      "text-generation"
    ],
    "optional": []
  },
  "output": {
    "kind": "text",
    "media_type": "text/plain",
    "description": "A concise plain-text summary for human review."
  },
  "provenance": {
    "origin": "studio-original",
    "created_by": "@andrewperis",
    "created_at": "2026-08-17T00:00:00Z",
    "source_references": [],
