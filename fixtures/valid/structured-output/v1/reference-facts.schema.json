{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:definitely-secure:contract:reference-facts:1.0.0:result",
  "title": "Synthetic reference facts result",
  "type": "object",
  "additionalProperties": false,
  "required": ["facts", "unknown_fields"],
  "properties": {
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "value"],
        "properties": {
          "field": { "type": "string", "minLength": 1 },
          "value": { "type": ["string", "number", "boolean", "null"] }
        }
      }
    },
    "unknown_fields": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
